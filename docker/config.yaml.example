# 复制为 docker/config.yaml 后，取消 docker-compose.yml 中的挂载注释即可生效。
# 注意: 容器默认以 -data-dir=/data 启动，所以配置文件必须挂载到 /data/config.yaml。

database:
  type: mysql
  mysql:
    host: mysql
    port: 3306
    user: claude
    password: change-me
    database: claude_api
    charset: utf8mb4

server:
  host: 0.0.0.0
  port: 62311

debug: false
